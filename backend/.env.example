# Copy to .env and adjust as needed.

# --- Database ---
# Default (dev): SQLite file, zero setup — leave unset to use it.
# Production (as specified): PostgreSQL.
# DATABASE_URL=postgresql+psycopg2://railway:railway@localhost:5432/railway_bps

# --- Optimization ---
OPT_TIME_LIMIT_SECONDS=20
SIM_TIME_LIMIT_SECONDS=8

# --- Logging (stdout by default; LOG_FILE enables a size-capped rotating file) ---
LOG_LEVEL=INFO
# LOG_FILE=logs/app.log
# LOG_MAX_BYTES=1000000
# LOG_BACKUPS=2

# --- Retention caps for metadata tables ---
# PLAN_VERSION_RETENTION=200
# AUDIT_RETENTION=10000
# SCENARIO_LIMIT=50

# --- CORS (frontend origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
